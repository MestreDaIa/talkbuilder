# --- Backend Config ---
SUPABASE_URL=https://fwoescubnnagdvwasbjl.supabase.co
SUPABASE_ANON_KEY=COLE_AQUI_SEU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SEU_SERVICE_ROLE_KEY
EVO_BASE_URL=https://evolution.zailom.com
EVO_GLOBAL_KEY=SUA_GLOBAL_KEY_DA_EVOLUTION

# --- zailom-wa-service (DEVEM SER IDENTICOS AOS DO ZAILOM BOOKING) ---
WA_SERVICE_URL=https://wa.zailom.com
WA_SERVICE_ADMIN_TOKEN=MESMO_ADMIN_TOKEN_DO_BOOKING
WA_WEBHOOK_SIGNING_SECRET=MESMO_SEGREDO_HMAC_DO_BOOKING

# --- Roteamento de canal (quem e o dono da instancia: Flow ou Booking) ---
# O Flow tenta primeiro ler a rota do proprio wa-service; se ele nao expuser,
# cai para a API do Booking usando as variaveis abaixo.
BOOKING_API_URL=https://api-booking.zailom.com
BOOKING_API_KEY=CHAVE_DA_API_DO_BOOKING
# Path do endpoint de rota no Booking ({instance} e substituido)
BOOKING_ROUTE_PATH=/v1/whatsapp/instances/{instance}/route
# TTL do cache de rota em ms (default 60000)
CHANNEL_ROUTE_TTL_MS=60000
# true = ignora mensagens quando a rota for desconhecida (default false)
STRICT_CHANNEL_ROUTE=false

# --- Frontend Config (TODOS devem apontar para o projeto fwoescubnnagdvwasbjl) ---
VITE_SUPABASE_URL=https://fwoescubnnagdvwasbjl.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_SEU_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_SEU_ANON_KEY
VITE_SUPABASE_PROJECT_ID=fwoescubnnagdvwasbjl
VITE_EXTERNAL_SUPABASE_URL=https://fwoescubnnagdvwasbjl.supabase.co
VITE_EXTERNAL_SUPABASE_ANON_KEY=COLE_AQUI_SEU_ANON_KEY
VITE_RUNTIME_URL=https://api-flowbuilder.zailom.com/runtime
VITE_BACKEND_URL=https://api-flowbuilder.zailom.com

# --- VPS/Traefik Config ---
SERVER_DOMAIN=api-flowbuilder.zailom.com
FRONTEND_DOMAIN=flow-builder.zailom.com
# NAO altere para 80: o container do server escuta 3000 (Traefik aponta para 3000)
PORT=3000
